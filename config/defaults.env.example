# Copy to defaults.env (optional) — no secrets required for local Ollama
OLLAMA_HOST=127.0.0.1:11434
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Defaults (2026-07-21 方案 v2：Qwen3.6/3.5 原生多模态三档)
LOCAL_LLM_DEFAULT=qwen3.6:35b-a3b-q4_K_M
LOCAL_LLM_CHAT=qwen3.6:35b-a3b-q4_K_M
LOCAL_LLM_QUALITY=qwen3.6:27b-q8_0
LOCAL_LLM_SPEED=qwen3.5:9b
# VL 不再单列：以上模型均原生支持图像输入
# 过渡期备用（验证后 ollama rm）：
# LOCAL_LLM_LEGACY=qwen3-coder:30b-a3b-q8_0
