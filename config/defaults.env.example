# Copy to defaults.env (optional) — no secrets required for local Ollama
OLLAMA_HOST=127.0.0.1:11434
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Defaults (2026-08-15 lineup v2.9: main/deep/fast tiers)
LOCAL_LLM_DEFAULT=qwen3.8:27b-q4_K_M
LOCAL_LLM_CHAT=qwen3.8:27b-q4_K_M
LOCAL_LLM_DEEP=qwen3.8:27b-q8_0
LOCAL_LLM_FAST=qwen3.5:9b
# No separate VL entries: all models above natively support image input
