# Copy to defaults.env (optional) — no secrets required for local Ollama
OLLAMA_HOST=127.0.0.1:11434
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Defaults follow config/models.manifest (this commit: lite-16 lineup).
# lite-16 (16GB) has a single LLM tier; larger lineups add deep/fast/chat/reason.
LOCAL_LLM_DEFAULT=qwen3.5:9b
LOCAL_LLM_CHAT=qwen3.5:9b
# main natively supports image input — no separate VL entry
