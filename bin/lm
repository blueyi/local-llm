#!/usr/bin/env bash
# =============================================================
# lm — unified entry point for the local model stack (local-llm CLI)
# =============================================================
# All local model operations go through this command.
# Subcommands are dispatched to scripts/.
#
# Usage: lm <command> [args...]
#
# [Daily]
#   lm status                     # Overview: models / weights dirs / disk
#   lm run [main|deep|fast|chat|reason]  # Interactive chat (default: main; any ollama tag also works)
#   lm test [tag] [prompt]        # Smoke test (tiers: main|deep|fast|embed|chat|reason|rerank)
#   lm image "prompt"             # Text-to-image (--model/--size/--steps/--seed/--edit, see lm image --help)
#   lm asr <audio>                # Speech-to-text via mlx-whisper (--model/--lang)
#   lm tts "text"                 # Text-to-speech via mlx-audio (--model/--voice/--lang/--play)
#
# [Deploy / Upgrade]
#   lm check                      # Health check + manifest reconciliation (no install)
#   lm deploy [tier] [--force] [--yes] [--skip-ollama-upgrade]
#                                 # Deploy LLMs; checks Ollama latest first (prompt / --yes auto-upgrade)
#   lm deploy --prune             # Deploy, then delete retired models (confirms first)
#   lm init                       # Check deps (offer auto-install) → probe this Mac → exact profile or fallback score → write manifests (--dry-run/--yes/--deploy/--stack/--skip-deps/--ram/--chip)
#   lm update                     # Recommend + update 3 tiers from remote catalog + hardware (--dry-run/--yes/--ram/--chip/--no-deploy)
#   lm get <query>                # Fuzzy-search remote model, interactive pick, pull (--tier/--tag/--yes/--dry-run)
#   lm pull-image <hf-repo>       # Download image-gen weights (direct pull via hf-mirror to ~/models/image-gen)
#   lm pull-speech [hf-repo]      # Download ASR weights (hf-mirror -> ~/models/speech)
#   lm pull-tts [hf-repo]         # Download TTS weights (hf-mirror -> ~/models/tts)
#   lm pull-gguf [tier...]        # Download manifest HF GGUFs into ~/models/gguf for LM Studio (--link)
#
# [Maintenance]
#   lm upgrade-ollama [--yes]     # Check GitHub latest Ollama; install when missing, prompt or auto-upgrade (darwin)
#   lm rm <name|tier> [--yes]     # Remove Ollama model (confirm unless --yes); syncs registry
#   lm import <name> <gguf> [ctx] # Manually import a single GGUF into Ollama
#   lm sync                       # Write `ollama list` back into docs/models-registry.md
#   lm help                       # This help
#
# Model list SSOT: config/models.manifest + image/speech/tts manifests
# Unified weights root: ~/models/{ollama,gguf,image-gen,speech,tts}
# =============================================================
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
S="$ROOT/scripts"
source "$ROOT/scripts/lib/common.sh"

usage() { grep -E '^#( |=)' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

CMD="${1:-help}"; shift || true
case "$CMD" in
  status)      exec "$S/status.sh" "$@" ;;
  run)
    TAG="${1:-main}"
    # Tier name -> manifest tag; unknown names pass through to ollama as-is.
    # Known-but-removed tiers (e.g. deep on lite-16) fail with guidance.
    TAG="$(resolve_llm_tag "$TAG")" || exit 1
    exec ollama run "$TAG" ;;
  test)        exec "$S/smoke-test.sh" "$@" ;;
  image)       exec "$S/gen-image.sh" "$@" ;;
  asr)         exec "$S/asr.sh" "$@" ;;
  tts)         exec "$S/tts.sh" "$@" ;;
  check)       exec "$S/deploy.sh" --check "$@" ;;
  deploy)      exec "$S/deploy.sh" "$@" ;;
  init)        exec "$S/init-models.sh" "$@" ;;
  update)      exec "$S/update-models.sh" "$@" ;;
  get)         exec "$S/get-model.sh" "$@" ;;
  pull-image)  exec "$S/pull-image-model.sh" "$@" ;;
  pull-speech) exec "$S/pull-speech-model.sh" "$@" ;;
  pull-tts)    exec "$S/pull-tts-model.sh" "$@" ;;
  pull-gguf)   exec "$S/pull-gguf.sh" "$@" ;;
  upgrade-ollama) exec "$S/upgrade-ollama.sh" "$@" ;;
  rm)          exec "$S/rm-model.sh" "$@" ;;
  import)      exec "$S/import-gguf.sh" "$@" ;;
  sync)        exec "$S/sync-registry.sh" "$@" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $CMD"; echo; usage; exit 1 ;;
esac
